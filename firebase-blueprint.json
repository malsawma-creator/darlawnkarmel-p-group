{
  "entities": {
    "Member": {
      "title": "Member",
      "description": "User profile",
      "type": "object",
      "properties": {
        "hming": { "type": "string", "maxLength": 100 },
        "role": { "type": "string", "enum": ["SECRETARY", "LEADER", "ASST_LEADER", "ASST_SECRETARY", "TREASURER", "FINANCE_SECRETARY", "COMMITTEE_OB", "MEMBER"] },
        "status": { "type": "string", "enum": ["Pending", "Approved", "Rejected"] },
        "isDeveloper": { "type": "boolean" }
      },
      "required": ["hming", "role"]
    },
    "Competition": {
      "title": "Competition",
      "description": "Contest definition",
      "type": "object",
      "properties": {
        "title": { "type": "string", "maxLength": 200 },
        "type": { "type": "string" },
        "status": { "type": "string", "enum": ["Active", "Closed"] }
      },
      "required": ["title", "type", "status"]
    },
    "Submission": {
      "title": "Submission",
      "description": "Competition entry",
      "type": "object",
      "properties": {
        "competitionId": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "memberId": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "title": { "type": "string", "maxLength": 200 }
      },
      "required": ["competitionId", "memberId", "title"]
    }
  },
  "firestore": {
    "/members/{memberId}": { "schema": "Member", "description": "User profiles" },
    "/competitions/{competitionId}": { "schema": "Competition", "description": "Contests" },
    "/competitions/{competitionId}/submissions/{submissionId}": { "schema": "Submission", "description": "Contest entries" }
  }
}
